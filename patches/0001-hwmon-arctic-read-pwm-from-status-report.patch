--- a/arctic_fan_controller.c
+++ b/arctic_fan_controller.c
@@ -4,7 +4,8 @@
  *
  * USB Custom HID device with 10 fan channels.
  * Exposes fan RPM (input) and PWM (0-255) via hwmon. Device pushes IN reports
