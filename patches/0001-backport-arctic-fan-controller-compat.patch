From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: arctic-fan-controller-unraid maintainers
Date: Thu, 3 Sep 2026 00:00:00 +0000
Subject: [PATCH] backport: add compatibility header for older Unraid kernels

Linux 6.12 and Linux 6.18 headers do not provide the Linux 7.2-era
__dma_from_device_group_begin/end annotations used around the embedded HID OUT
report buffer. Define them as no-ops for kernels older than 7.2 and include the
compatibility header from the otherwise-upstream driver.

---
 driver/arctic_fan_controller.c |  2 ++
 driver/compat.h                | 22 ++++++++++++++++++++++
 2 files changed, 24 insertions(+)
 create mode 100644 driver/compat.h

diff --git a/driver/arctic_fan_controller.c b/driver/arctic_fan_controller.c
index 0000000..0000000 100644
--- a/driver/arctic_fan_controller.c
+++ b/driver/arctic_fan_controller.c
@@ -21,6 +21,8 @@
 #include <linux/string.h>
 #include <linux/unaligned.h>
 
+#include "compat.h"
+
 #define ARCTIC_VID			0x3904
 #define ARCTIC_PID			0xF001
 #define ARCTIC_NUM_FANS			10
diff --git a/driver/compat.h b/driver/compat.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/driver/compat.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef ARCTIC_FAN_CONTROLLER_COMPAT_H
+#define ARCTIC_FAN_CONTROLLER_COMPAT_H
+
+#include <linux/version.h>
+
+/*
+ * Linux 7.2-era DMA/cacheline annotations are not present in Linux 6.12 or
+ * 6.18. They are layout/debug annotations only for this driver's embedded HID
+ * report buffer, so older kernels can build with no-op definitions.
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 2, 0)
+#ifndef __dma_from_device_group_begin
+#define __dma_from_device_group_begin(...)
+#endif
+#ifndef __dma_from_device_group_end
+#define __dma_from_device_group_end(...)
+#endif
+#endif
+
+#endif /* ARCTIC_FAN_CONTROLLER_COMPAT_H */
-- 
2.0.0
